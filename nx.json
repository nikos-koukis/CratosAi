{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "lint": {
      "cache": true
    },
    "format-check": {
      "cache": true
    },
    "build": {
      "cache": true
    },
    "test": {
      "cache": true
    }
  }
}
