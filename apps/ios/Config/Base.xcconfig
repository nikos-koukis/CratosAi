// Shared build settings. Your team and bundle id prefix go in
// Config/Local.xcconfig (git-ignored), e.g.:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   JARVIS_BUNDLE_ID_PREFIX = com.yourname
JARVIS_BUNDLE_ID_PREFIX = ai.cratos
PRODUCT_BUNDLE_IDENTIFIER = $(JARVIS_BUNDLE_ID_PREFIX).jarvis
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

#include? "Local.xcconfig"
