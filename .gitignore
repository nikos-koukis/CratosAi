# Dependencies
node_modules/

# Nx
.nx/cache/
.nx/workspace-data/

# Rust
target/

# Generated code: gen/go, gen/python, gen/swift and gen/ts are committed and
# kept in sync with /proto by `pnpm nx run proto:lint`; anything else is not.
gen/*
!gen/go/
!gen/python/
!gen/swift/
!gen/ts/

# Python
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Build artifacts
dist/
*.binpb

# Local environment and secrets
.env
.env.*
!.env.example
# Apple keys and certificates (APNs auth keys live in ~/.config/jarvis/apns)
*.p8
*.p12
*.mobileprovision

# OS / editors
.DS_Store
.idea/

# Local development state (dev certificates etc.)
.dev/

# Swift / Xcode
.build/
.swiftpm/
*.xcodeproj/
xcuserdata/
DerivedData/

# Per-developer Xcode settings (team, bundle id)
apps/ios/Config/Local.xcconfig
