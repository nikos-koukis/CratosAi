# Variables deploy/compose/compose.yaml expects. Do NOT copy this file:
# scripts/init-env.sh (run automatically by `pnpm nx run infra:up`) generates
# .env with random values. This file only documents them and lets
# `infra:lint` validate the compose file.
POSTGRES_PASSWORD=example-only
VAULT_DB_PASSWORD=example-only
MCP_DB_PASSWORD=example-only
ORCH_DB_PASSWORD=example-only
DRAGONFLY_PASSWORD=example-only
NEO4J_PASSWORD=example-only
QDRANT_API_KEY=example-only

# Optional host port overrides (always bound to 127.0.0.1):
# JARVIS_POSTGRES_PORT=55432
# JARVIS_DRAGONFLY_PORT=56379
# JARVIS_NEO4J_HTTP_PORT=57474
# JARVIS_NEO4J_BOLT_PORT=57687
# JARVIS_QDRANT_HTTP_PORT=56333
# JARVIS_QDRANT_GRPC_PORT=56334
