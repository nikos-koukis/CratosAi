{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "proto",
  "projectType": "library",
  "sourceRoot": "proto",
  "tags": [
    "type:contract"
  ],
  "namedInputs": {
    "protos": [
      "{projectRoot}/**/*.proto",
      "{workspaceRoot}/buf.yaml"
    ]
  },
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "protos",
        "{workspaceRoot}/gen/go/**/*",
        "{workspaceRoot}/buf.gen.yaml",
        "{workspaceRoot}/tools/go/go.mod",
        "{workspaceRoot}/gen/python/**/*",
        "{workspaceRoot}/gen/python/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "options": {
        "command": "buf lint && tools/check-generated-go.sh && tools/check-generated-python.sh"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "inputs": [
        "protos"
      ],
      "options": {
        "command": "buf format --diff --exit-code"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf format --write"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "protos"
      ],
      "options": {
        "command": "buf build"
      }
    },
    "breaking": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf breaking --against '.git#branch=main'"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "rm -rf gen/go/jarvis && buf generate && (cd gen/go && go mod tidy) && tools/gen-python.sh"
      }
    }
  }
}
