{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "vault",
  "projectType": "application",
  "sourceRoot": "services/vault/src",
  "tags": [
    "type:service",
    "lang:rust"
  ],
  "implicitDependencies": [
    "proto"
  ],
  "namedInputs": {
    "rust": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.dev/**/*",
      "{workspaceRoot}/libs/rust/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/proto/**/*.proto"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "rust"
      ],
      "options": {
        "command": "cargo build -p jarvis-vault --locked"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "rust"
      ],
      "options": {
        "command": "cargo test -p jarvis-vault --locked"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "rust"
      ],
      "options": {
        "command": "cargo clippy -p jarvis-vault --all-targets --locked -- -D warnings"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "inputs": [
        "rust"
      ],
      "options": {
        "command": "cargo fmt -p jarvis-vault --check"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p jarvis-vault"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "services/vault/scripts/dev-run.sh"
      },
      "dependsOn": [
        {
          "projects": [
            "infra"
          ],
          "target": "up"
        }
      ]
    }
  }
}
