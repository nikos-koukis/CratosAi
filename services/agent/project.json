{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "agent",
  "projectType": "application",
  "sourceRoot": "services/agent/src",
  "tags": [
    "type:service",
    "lang:python"
  ],
  "implicitDependencies": [
    "proto"
  ],
  "namedInputs": {
    "python": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.dev/**/*",
      "{workspaceRoot}/gen/python/**/*",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/.python-version"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "python"
      ],
      "options": {
        "command": "uv sync --frozen --all-packages --all-groups --quiet && uv run --frozen python -m compileall -q src",
        "cwd": "services/agent"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "python"
      ],
      "options": {
        "command": "uv run --frozen pytest -q",
        "cwd": "services/agent"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "python"
      ],
      "options": {
        "command": "uv lock --check --quiet && uv run --frozen ruff check . && uv run --frozen mypy src tests && bash -n scripts/*.sh",
        "cwd": "services/agent"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "inputs": [
        "python"
      ],
      "options": {
        "command": "uv run --frozen ruff format --check .",
        "cwd": "services/agent"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --frozen ruff format .",
        "cwd": "services/agent"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "scripts/dev-run.sh",
        "cwd": "services/agent"
      }
    }
  }
}
